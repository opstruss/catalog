# The plugin asks for every variable, and pass: of the project says which
# reach tofu: TF_VAR_<name> sets a variable of the module, and one that
# pass: leaves out does not reach it.

env HOME=$WORK/home
env TF_VAR_zone=example.com
env TF_VAR_other=left-out
symlink catalog -> $CATALOG

exec opstruss up --yes
stdout '^default/infra: up: done$'
exec opstruss outputs --json
stdout '"zone": "example.com"'
stdout '"other": "none"'

-- opstruss.yaml --
name: app
outputs:
  zone: ${{ units.infra.outputs.zone }}
  other: ${{ units.infra.outputs.other }}
uses:
  tofu:
    source: ./catalog/plugins/tofu
    pass: [TF_VAR_z*]
units:
  infra:
    uses: tofu
    with:
      dir: ./infra
-- infra/main.tf --
variable "zone" {
  type = string
}

variable "other" {
  type    = string
  default = "none"
}

resource "terraform_data" "this" {
  input = "${var.zone} ${var.other}"
}

output "zone" {
  value = var.zone
}

output "other" {
  value = var.other
}
