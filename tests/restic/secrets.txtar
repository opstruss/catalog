# The password and the credentials reach restic as variables, never as
# arguments, which bin/restic writes down before it runs restic, and stay
# out of the log and the records. A name in credentials that cannot be
# one of a variable, or that names the repository or its password, stops
# the call.

env HOME=$WORK/home
env RESTIC_PW=secret-pw
env KEY=secret-key
env PATH=$WORK/bin:$PATH
chmod 0755 bin/restic
symlink catalog -> $CATALOG

exec opstruss up --yes
exec opstruss push
exec grep -c 'backup --json' argv.log
! exec grep -q secret- argv.log
exec grep -c '^AWS_ACCESS_KEY_ID=secret-key$' env.log
! exec grep -rq secret- .opstruss/runs .opstruss/state

! exec opstruss lower
stdout 'the input credentials has lower, which is not the name of a variable: capital letters, digits, and _$'
! exec opstruss password
stdout 'the input credentials cannot set RESTIC_PASSWORD; the inputs repository and password give the repository$'

-- bin/restic --
#!/bin/sh
printf '%s\n' "$*" >>argv.log
[ -z "${AWS_ACCESS_KEY_ID:-}" ] || echo "AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID" >>env.log
PATH=${PATH#*:} exec restic "$@"
-- opstruss.yaml --
name: app
uses:
  ops: ./catalog
  nas:
    source: ops.restic
    with:
      repository: ./repo
      password: ${{ secrets.pw }}
      credentials:
        AWS_ACCESS_KEY_ID: ${{ secrets.key }}
secrets:
  pw: {env: RESTIC_PW}
  key: {env: KEY}
units:
  repo:
    uses: nas
tasks:
  push:
    steps:
      - nas.backup: {paths: [./data]}
  lower:
    steps:
      - nas.check: {credentials: {lower: x}}
  password:
    steps:
      - nas.check: {credentials: {RESTIC_PASSWORD: x}}
-- data/a --
aaaa
